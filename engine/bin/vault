#!/usr/bin/env bash
# CWP Vault engine entry point. See docs/ENGINE.md.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

VAULT_VERSION=0.2.0
VAULT_SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
VAULT_LIB=${VAULT_LIB:-${VAULT_SELF%/*}/../lib}
VAULT_HOME=${VAULT_HOME:-/usr/local/cwp-vault}

# shellcheck source=../lib/log.sh
source "$VAULT_LIB/log.sh"
# shellcheck source=../lib/config.sh
source "$VAULT_LIB/config.sh"
# shellcheck source=../lib/lock.sh
source "$VAULT_LIB/lock.sh"
# shellcheck source=../lib/accounts.sh
source "$VAULT_LIB/accounts.sh"
# shellcheck source=../lib/restic.sh
source "$VAULT_LIB/restic.sh"
# shellcheck source=../lib/status.sh
source "$VAULT_LIB/status.sh"
# shellcheck source=../lib/notify.sh
source "$VAULT_LIB/notify.sh"
# shellcheck source=../lib/backup.sh
source "$VAULT_LIB/backup.sh"
# shellcheck source=../lib/server.sh
source "$VAULT_LIB/server.sh"
# shellcheck source=../lib/maintain.sh
source "$VAULT_LIB/maintain.sh"
# shellcheck source=../lib/jobs.sh
source "$VAULT_LIB/jobs.sh"
# shellcheck source=../lib/restore.sh
source "$VAULT_LIB/restore.sh"
# shellcheck source=../lib/storage.sh
source "$VAULT_LIB/storage.sh"
# shellcheck source=../lib/admin.sh
source "$VAULT_LIB/admin.sh"
# shellcheck source=../lib/immutable.sh
source "$VAULT_LIB/immutable.sh"
# shellcheck source=../lib/schedule.sh
source "$VAULT_LIB/schedule.sh"
# shellcheck source=../lib/export.sh
source "$VAULT_LIB/export.sh"
# shellcheck source=../lib/orphans.sh
source "$VAULT_LIB/orphans.sh"
# shellcheck source=../lib/verify.sh
source "$VAULT_LIB/verify.sh"

ARG_ACCOUNT='' ARG_ALL=0 ARG_DRY=0 ARG_JSON=0 ARG_SNAPSHOT=latest ARG_WHAT=''
ARG_DB='' ARG_TARGET='' ARG_TARGET_DB='' ARG_TAIL='' ARG_QUIET=0 ARG_BEFORE='' ARG_YES=0 ARG_PURGE=0
ARG_DETACH=0 ARG_INPLACE=0 ARG_CONFIRM='' ARG_MAILBOX='' ARG_JOB='' ARG_ID='' ARG_ENCRYPT=0 ARG_TIME='' ARG_ENABLED=''
declare -a ARG_POS=() ARG_PATHS=()
VAULT_CMD=''
declare -a VAULT_ARGS=()

usage_err() {
  log_error "$*"
  if [[ $ARG_JSON == 1 ]]; then printf '{"error":%s,"code":2}\n' "$(json_str "$*")"; fi
  printf "Try: vault %s --help\n" "${VAULT_CMD:-}" >&2
  exit 2
}

help_text() {
  case ${1:-} in
    init) echo "vault init [--json]              create missing repositories (accounts and _server)" ;;
    backup) echo "vault backup --account U | --all [--dry-run] [--quiet]" ;;
    restore) cat <<'EOF'
vault restore --account U --what files|mail|meta|mailauth|db [--snapshot ID|latest]
              [--path P ...] [--db NAME] [--mailbox user@domain] [--target DIR | --target-db NAME]
              [--in-place --snapshot ID --confirm U] [--detach] [--dry-run] [--json]
Files go to --target (must be new or empty; default: a fresh directory under the restore root).
Databases go into --target-db, which must not exist.
--in-place restores into the live account (files, db, or mail with --mailbox) after a fresh safety backup;
it needs an explicit --snapshot and --confirm equal to the account name.
--detach queues the restore as a background job and prints {"job":ID}.
EOF
      ;;
    jobs) echo "vault jobs [--json]               the last 20 restore jobs" ;;
    job) echo "vault job --id ID [--json]         one restore job (state, progress, result)" ;;
    schedule) cat <<'EOF'
vault schedule get [--json]
vault schedule set [--time HH:MM] [--enabled yes|no] [--json]
Reads or changes the nightly backup line of the cron file (server local time). Prune and check are shown, not changed.
EOF
      ;;
    export) cat <<'EOF'
vault export --account U --what files|db|mail [--snapshot ID|latest] [--path P] [--db NAME] [--mailbox user@domain]
             [--encrypt] [--detach] [--json]
Writes one archive (files and mail: .tar.gz, database: .sql.gz) to the exports folder for download.
--encrypt reads the passphrase (12 to 256 characters) from the first line of stdin and writes <name>.gpg.
EOF
      ;;
    exports) echo "vault exports [--json]          the exports waiting for download" ;;
    export-clean) echo "vault export-clean [--quiet]    delete expired exports (hourly cron)" ;;
    export-path) echo "vault export-path --job ID      print the file path of an export (for the web page to stream)" ;;
    audit-download) echo "vault audit-download --job ID  record a download in the audit log" ;;
    snapshots) echo "vault snapshots --account U [--json]" ;;
    ls) echo "vault ls --account U [--snapshot ID] [--path P] --json    list one directory level of a snapshot" ;;
    prune) echo "vault prune --account U | --all [--quiet]" ;;
    check) echo "vault check --account U | --all [--quiet]" ;;
    unlock) echo "vault unlock --account U | --all" ;;
    recover) cat <<'EOF'
vault recover --account U | --all [--before ISO8601] [--yes] [--json]
Immutable mode only. Lists the delete markers a wipe left in the account repositories (newer than --before
when given). Nothing changes without --yes; with it the markers are removed, then restic unlock --remove-all
and restic check run on each repository.
EOF
      ;;
    verify-restore) cat <<'EOF'
vault verify-restore [--account U | --all] [--json]
Restore test. For each account (one random account when neither flag is given): restores up to 20 random files of
the latest files snapshot into a throwaway directory and compares their sizes, and imports the latest dump of every
database into a throwaway database and compares the table count. Both are removed afterwards. The result goes to
var/status/verify-<account>.json; a failure sends the usual alert and exits 1.
EOF
      ;;
    orphans) cat <<'EOF'
vault orphans [--json] [--purge [--yes]]
Lists the repositories of accounts that no longer exist in CWP, with their newest snapshot. --purge shows which
are older than ORPHAN_KEEP_DAYS; with --yes it runs "restic forget --keep-within <N>d --prune" on them.
Needs the aws CLI to list the repositories.
EOF
      ;;
    status) echo "vault status [--json]" ;;
    test-storage) echo "vault test-storage [--json]     write, read back and delete a probe snapshot" ;;
    verify-secrets) echo "vault verify-secrets           check that every repository opens with the current password" ;;
    config) echo "vault config get [--json] | vault config set KEY=VALUE ..." ;;
    secrets) echo "vault secrets status [--json] | vault secrets set   (KEY=VALUE lines on stdin)" ;;
    log) echo "vault log --tail N [--json]" ;;
    version) echo "vault version" ;;
    *) cat <<'EOF'
Usage: vault <command> [options]   (vault <command> --help for details)
Commands: init backup restore jobs job snapshots ls prune check unlock recover status schedule
          verify-restore orphans export exports export-clean export-path audit-download test-storage verify-secrets config secrets log version
Exit codes: 0 ok, 1 some accounts failed, 2 config/usage error, 3 already running, 4 storage unreachable
EOF
      ;;
  esac
}

# args_parse "allowed option names" args...
args_parse() {
  local allowed=" $1 " opt val name has
  shift
  ARG_POS=()
  while (($# > 0)); do
    opt=$1
    shift
    has=0
    val=''
    if [[ $opt != --* ]]; then
      [[ $allowed == *" pos "* ]] || usage_err "unexpected argument"
      ARG_POS+=("$opt")
      continue
    fi
    if [[ $opt == *=* ]]; then
      val=${opt#*=}
      opt=${opt%%=*}
      has=1
    fi
    name=${opt#--}
    [[ $name == quiet ]] || [[ $allowed == *" $name "* ]] || usage_err "unknown option $opt"
    case $name in
      all) ARG_ALL=1 ;;
      dry-run) ARG_DRY=1 ;;
      yes) ARG_YES=1 ;;
      detach) ARG_DETACH=1 ;;
      in-place) ARG_INPLACE=1 ;;
      encrypt) ARG_ENCRYPT=1 ;;
      json) ARG_JSON=1 ;;
      purge) ARG_PURGE=1 ;;
      quiet) ARG_QUIET=1 ;;
      account | snapshot | what | path | db | target | target-db | tail | before | confirm | mailbox | job | id | time | enabled)
        if ((!has)); then
          (($# > 0)) || usage_err "$opt needs a value"
          val=$1
          shift
        fi
        case $name in
          account) ARG_ACCOUNT=$val ;;
          snapshot) ARG_SNAPSHOT=$val ;;
          what) ARG_WHAT=$val ;;
          path) ARG_PATHS+=("$val") ;;
          db) ARG_DB=$val ;;
          target) ARG_TARGET=$val ;;
          target-db) ARG_TARGET_DB=$val ;;
          tail) ARG_TAIL=$val ;;
          before) ARG_BEFORE=$val ;;
          confirm) ARG_CONFIRM=$val ;;
          mailbox) ARG_MAILBOX=$val ;;
          job) ARG_JOB=$val ;;
          id) ARG_ID=$val ;;
          time) ARG_TIME=$val ;;
          enabled) ARG_ENABLED=$val ;;
          *) ;;
        esac
        ;;
      *) usage_err "unknown option $opt" ;;
    esac
  done
}

# shellcheck disable=SC2329 # invoked through trap
cleanup() {
  local fd
  job_on_exit
  verify_cleanup
  for fd in "${LOCK_FDS[@]}"; do exec {fd}>&- 2>/dev/null || true; done
  run_unregister
}

# with_alerts FUNC : heartbeat + failure notifications around a long-running command.
with_alerts() {
  local rc=0
  hb_ping start
  "$@" || rc=$?
  if ((rc == 0)); then
    hb_ping success
  else
    hb_ping fail
    notify_failure "$VAULT_CMD" "$rc"
  fi
  return "$rc"
}

main() {
  local cmd=${1:-} a rc=0
  if (($# > 0)); then shift; fi
  case $cmd in
    '' | -h | --help | help) help_text; exit 0 ;;
    version | --version) echo "cwp-vault $VAULT_VERSION"; exit 0 ;;
    init | backup | restore | jobs | job | snapshots | ls | prune | check | unlock | recover | verify-restore | orphans | status | schedule | export | exports | export-clean | export-path | audit-download | test-storage | verify-secrets | config | secrets | log) ;;
    *) VAULT_CMD=''; usage_err "unknown command: $cmd" ;;
  esac
  for a in "$@"; do
    if [[ $a == -h || $a == --help ]]; then help_text "$cmd"; exit 0; fi
  done
  VAULT_CMD=$cmd
  VAULT_ARGS=("$@")
  case $cmd in
    init) args_parse "json" "$@" ;;
    verify-secrets) args_parse "" "$@" ;;
    backup) args_parse "account all dry-run" "$@" ;;
    restore) args_parse "account snapshot what path db target target-db mailbox in-place confirm detach job dry-run json" "$@" ;;
    schedule) args_parse "time enabled json pos" "$@" ;;
    export) args_parse "account snapshot what path db mailbox encrypt detach job json" "$@" ;;
    exports | export-clean) args_parse "json" "$@" ;;
    export-path | audit-download) args_parse "job json" "$@" ;;
    jobs) args_parse "json" "$@" ;;
    job) args_parse "id json" "$@" ;;
    snapshots) args_parse "account json" "$@" ;;
    ls) args_parse "account snapshot path json" "$@" ;;
    prune | check | unlock) args_parse "account all" "$@" ;;
    recover) args_parse "account all before yes json" "$@" ;;
    verify-restore) args_parse "account all json" "$@" ;;
    orphans) args_parse "json purge yes" "$@" ;;
    status | test-storage) args_parse "json" "$@" ;;
    config | secrets) args_parse "json pos" "$@" ;; # sub-command and KEY=VALUE pairs
    log) args_parse "tail json" "$@" ;;
    *) ;;
  esac
  if [[ $ARG_QUIET == 1 ]]; then VAULT_QUIET=1; fi

  vault_paths
  vault_dirs
  trap cleanup EXIT
  trap 'log_error "unexpected failure at line $LINENO"' ERR
  run_register

  case $cmd in
    status) cmd_status; exit 0 ;;
    log) cmd_log; exit 0 ;;
    jobs) cmd_jobs; exit 0 ;;
    job) cmd_job; exit 0 ;;
    config) cmd_config; exit 0 ;;
    secrets) cmd_secrets; exit 0 ;;
    schedule) cmd_schedule; exit 0 ;;
    exports) cmd_exports; exit 0 ;;
    export-clean) cmd_export_clean; exit 0 ;;
    export-path) cmd_export_path; exit 0 ;;
    audit-download) cmd_audit_download; exit 0 ;;
    *) ;;
  esac

  cfg_load
  case $cmd in
    init) cmd_init || rc=$? ;;
    backup) if ((ARG_DRY)); then cmd_backup || rc=$?; else with_alerts cmd_backup || rc=$?; fi ;; # a dry run never pings or alerts
    restore) cmd_restore || rc=$? ;;
    export) cmd_export || rc=$? ;;
    snapshots) cmd_snapshots || rc=$? ;;
    ls) cmd_ls || rc=$? ;;
    prune) with_alerts cmd_prune || rc=$? ;;
    check) with_alerts cmd_check || rc=$? ;;
    unlock) cmd_unlock || rc=$? ;;
    recover) cmd_recover || rc=$? ;;
    verify-restore) verify_with_alert || rc=$? ;;
    orphans) cmd_orphans || rc=$? ;;
    test-storage) cmd_test_storage || rc=$? ;;
    verify-secrets) cmd_verify_secrets || rc=$? ;;
    *) ;;
  esac
  exit "$rc"
}

main "$@"
